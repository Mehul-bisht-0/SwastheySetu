# Copy to .env and fill in. apps/api/src/config.ts validates these with zod and
# CRASHES ON BOOT if a required value is missing. That is intentional.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://swasthya:swasthya_dev_pw@localhost:5432/swasthyasetu

# REQUIRED, minimum 32 characters. There is deliberately no default in code:
# an unset secret must crash the server, never sign tokens with "changeme".
JWT_SECRET=
# Long TTLs on purpose: ASHA workers go days without connectivity.
JWT_EXPIRES_IN=30d

# Exact origins only, comma separated. Never "*".
CORS_ORIGINS=http://localhost:8081,http://192.168.1.10:8081

LOG_LEVEL=info

# Development-only identity provider simulation. Production must use an
# authorised external provider adapter; it must never accept "mock".
IDENTITY_PROVIDER_MODE=mock

# Development-only ABHA consent/HIU simulation. Production requires ABDM
# sandbox certification/credentials and an external adapter.
ABDM_MODE=mock

# The single seeded district for the demo.
DEMO_DISTRICT_CODE=227

# Freshness decay constant, days. See IMPLEMENTATION_PLAN.md 6.6
FRESHNESS_TAU_DAYS=14

# Build-time only. NEVER called from a mobile request path.
OSRM_URL=http://localhost:5000

# RAG — unused in v1. Present so no key is ever added to the mobile client later.
LLM_API_KEY=
EMBEDDING_MODEL=

# Stage 2 synthetic intake retention. Set explicitly for your test environment.
# No production policy is implied; case collection is disabled while blank.
CASE_RETENTION_DAYS=

# Phase 2 provider webhook authentication, minimum 32 characters. Keep server-side.
IVR_WEBHOOK_SECRET=
