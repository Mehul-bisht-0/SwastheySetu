{
  "name": "@swasthyasetu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "comment": "Fastify + node-postgres, no ORM. Raw parameterised SQL lives in repo.ts files. Run directly with node - Node 22 strips the types, so there is no build step and relative imports must end in .ts (AGENTS.md section 3).",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "migrate": "node --disable-warning=ExperimentalWarning src/db/migrate.ts",
    "seed": "node --disable-warning=ExperimentalWarning ../../infra/seed/load.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@swasthyasetu/contracts": "0.1.0",
    "@swasthyasetu/core": "0.1.0",
    "fastify": "5.12.1",
    "@fastify/cors": "10.1.0",
    "@fastify/jwt": "9.1.0",
    "@fastify/rate-limit": "10.3.0",
    "pg": "8.13.1",
    "bcryptjs": "2.4.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "@types/bcryptjs": "2.4.6"
  }
}
