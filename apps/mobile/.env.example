# apps/mobile/.env.example - copy to apps/mobile/.env
#
# READ THIS BEFORE ADDING A VARIABLE.
#
# Anything prefixed EXPO_PUBLIC_ is INLINED INTO THE JAVASCRIPT BUNDLE at build
# time. It is not a secret, it is not obfuscated, and anyone with the APK can
# read it in about thirty seconds. Only values you would happily print on a
# poster belong in this file.
#
# There is therefore no LLM key here, no database URL and no JWT secret. Every
# model call and every database query happens on the backend, which is the
# whole point of GUARDRAIL 7. scripts/check-no-secrets.mjs enforces it and
# `npm run verify` runs it.

# Where the API lives. On a physical Android device, "localhost" is the phone
# itself - use your machine's LAN address, the same one you put in CORS_ORIGINS.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Shown in the About screen so a demo audience can tell which build they are
# looking at. Cosmetic.
EXPO_PUBLIC_BUILD_LABEL=dev
